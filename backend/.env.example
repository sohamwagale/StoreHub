PORT=5000
MONGODB_URI=mongodb://localhost:27017/shop-rating-platform
JWT_SECRET=change-this-to-a-secure-random-secret-key-in-production
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:3000

# AWS S3 Storage (Optional: uploads will use local storage if not provided)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=

# Transactional Emails with Resend (Optional: will simulate and log reset links to console if not provided)
RESEND_API_KEY=
EMAIL_FROM=StoreRank <onboarding@resend.dev>

# Google OAuth 2.0 (Optional: required for Google Sign-In verification)
GOOGLE_CLIENT_ID=

